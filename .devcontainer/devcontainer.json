{
    "name": "NCNW Development Container",
    "privileged": true,
    "remoteUser": "container_user",
    "containerUser": "container_user",
    "image": "soham2560/nocontactnoworries",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/container_user/NoContactNoWorries,type=bind",
    "workspaceFolder": "/home/container_user/NoContactNoWorries",
    "customizations": {
        "vscode": {
            "extensions":[
				"althack.ament-task-provider",
				"betwo.b2-catkin-tools",
				"DotJoshJohnson.xml",
				"ms-azuretools.vscode-docker",
				"ms-iot.vscode-ros",
				"ms-python.python",
				"ms-vscode.cpptools",
				"redhat.vscode-yaml",
                "seunlanlege.action-buttons",
				"smilerobotics.urdf",
				"streetsidesoftware.code-spell-checker",
				"twxs.cmake",
				"yzhang.markdown-all-in-one",
				"zachflower.uncrustify"
            ]
        }
    },
    "containerEnv": {
		"DISPLAY":"${localEnv:DISPLAY}", // Needed for GUI try ":0" for windows
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
		"XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
		"PULSE_SERVER": "${localEnv:PULSE_SERVER}",
        "QT_X11_NO_MITSHM": "1",
		"LIBGL_ALWAYS_SOFTWARE": "1" // Needed for software rendering of opengl
    },
    "runArgs": [
        "--gpus=all",
        // RealTime
		"--cap-add=SYS_NICE",
        "--ulimit=rtprio=99",
        "--ulimit=rttime=-1",
        "--ulimit=memlock=8428281856",
        // This will allow you to use a ptrace-based debugger like C++, Go, and Rust.
		"--cap-add=all",
        "--security-opt=seccomp:unconfined",
        "--security-opt=apparmor:unconfined",
        "--volume=/dev:/dev",
        "--net=host",
        "--ipc=host",
        "--name=ncnw_development_container"
    ],
    "postStartCommand": "pip install -e /home/container_user/NoContactNoWorries"
}